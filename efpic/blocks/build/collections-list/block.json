{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "efpic/collections-list",
  "version": "1.0.0",
  "title": "efpic Collections List",
  "category": "media",
  "icon": "list-view",
  "description": "Display a list of collections",
  "example": {},
	"supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "attributes": {
    "postStatus": {
      "type": "string",
      "default": "any"
    },
    "email": {
      "type": "string",
      "default": ""
    },
    "currentUser": {
      "type": "boolean",
      "default": false
    },
    "ids": {
      "type": "string",
      "default": ""
    },
    "order": {
      "type": "string",
      "default": "date_desc"
    },
    "emptyMessage": {
      "type": "string",
      "default": "No collections found."
    }
  },
  "textdomain": "efpic",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}